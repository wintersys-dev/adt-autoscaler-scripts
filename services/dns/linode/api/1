set -e

# Resolve HOME baseline layout securely
if [ -r /home/homedir.dat ]
then
        HOME="$(/bin/cat /home/homedir.dat)"
else
        /bin/echo "Application framework configuration file missing at /home/homedir.dat" >&2
        exit 1
fi

# Input validation
if [ -z "${1}" ] || [ -z "${2}" ]
then
        /bin/echo "Error: Two arguments are required."
        /bin/echo "Usage: $0 <website_url> <ip>" 
        exit 1
fi

# Parse localized networking components safely using modern subshells
domain_url="$(/bin/echo "${1}" | /usr/bin/cut -d'.' -f2-)"
ip="${2}"

# Extract authorized structural access keys safely
TOKEN="$(${HOME}/utilities/config/ExtractConfigValue.sh 'DNSSECURITYKEY')"

if [ -z "${TOKEN}" ]
then
        /bin/echo "Error: Failed to retrieve security token configuration key." >&2
        exit 1
fi

# Fetch active domain zone layouts securely with manual intercept hooks to catch runtime exceptions
set +e
api_domain_json="$(/bin/echo "Authorization: Bearer ${TOKEN}" | /usr/bin/curl -H @- -s "https://api.linode.com/v4/domains")"
domain_exit_code="$?"
set -e

if [ "${domain_exit_code}" -ne 0 ] || [ -z "${api_domain_json}" ]
then
        /bin/echo "DNS domain ID not successfully obtained" >&2
        unset TOKEN
        exit 1
fi

# Extract the matching unique domain layout tracking zone ID cleanly
domain_id="$(/bin/echo "${api_domain_json}" | /usr/bin/jq -r --arg dom "${domain_url}" '.data[] | select(.domain | contains($dom)) | .id // empty')"

if [ -z "${domain_id}" ]
then
        /bin/echo "DNS domain ID not successfully obtained" >&2
        unset TOKEN
        exit 1
fi

# Query specific records associated with the matched domain ID explicitly targeting the records endpoint
set +e
api_records_json="$(/bin/echo "Authorization: Bearer ${TOKEN}" | /usr/bin/curl -H @- -s "https://linode.com/${domain_id}/records")"
records_exit_code="$?"
set -e

if [ "${records_exit_code}" -ne 0 ] || [ -z "${api_records_json}" ]
then
        /bin/echo "DNS record ID not successfully obtained" >&2
        unset TOKEN
        exit 1
fi

# Isolate target host tracking properties matching the target IP destination cleanly
record_id="$(/bin/echo "${api_records_json}" | /usr/bin/jq -r --arg target_ip "${ip}" '.data[] | select(.target == $target_ip) | .id // empty')"

if [ -z "${record_id}" ]
then
        /bin/echo "DNS record ID not successfully obtained" >&2
        unset TOKEN
        exit 1
fi

# Dispatch DELETE command to drop specified record mapping architecture cleanly
set +e
delete_response="$(/bin/echo "Authorization: Bearer ${TOKEN}" | /usr/bin/curl -H @- -s -X DELETE "https://linode.com/${domain_id}/records/${record_id}")"
delete_exit_code="$?"
set -e

if [ "${delete_exit_code}" -ne 0 ]
then
        /bin/echo "DNS record not successfully deleted" >&2
        unset TOKEN
        exit 1
fi

unset TOKEN
exit 0
